# Bu dosyayı .env olarak kopyala ve doldur

# --- Zamanlama ---
TIMEZONE=Europe/Istanbul
SLOTS=12:00,19:00
SLOT_GRACE_MIN=30
MAX_ATTEMPTS=3
DRY_RUN=0

# --- Açıklama üretimi (Claude) ---
ANTHROPIC_API_KEY=
CAPTION_MODEL=claude-sonnet-5
HASHTAG_COUNT=8
# Boş bırakırsan varsayılan Zibo tarifi kullanılır (captioner.py > DEFAULT_BRIEF)
CAPTION_BRIEF=
# Her gönderiye sabit eklenecek hashtag(ler), virgülle
FIXED_HASHTAGS=ziboapp
# 0 yaparsan üretilen açıklamalar "approved": false ile gelir; posts.json'da true yapana kadar paylaşılmaz
AUTO_APPROVE=1

# --- Fotoğraf barındırma (Instagram fotoğrafı link olarak ister) ---
IMAGE_HOST=imgbb
IMGBB_API_KEY=
# Link kaç saniye sonra silinsin (86400 = 1 gün)
IMGBB_EXPIRATION=86400
# Kendi sunucun/bucket'ın varsa: IMAGE_HOST=static ve bu adres
PUBLIC_BASE_URL=

# --- Platformlar ---
DEFAULT_PLATFORMS=instagram
POSTS_DIR=posts
POSTS_JSON=posts.json
STATE_FILE=state.json

# --- Instagram (Business/Creator hesap) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v23.0

# --- TikTok (isteğe bağlı; fotoğraf için doğrulanmış kendi domainin gerekir) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY=SELF_ONLY
